{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "blog/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/data/(.*)",
      "status": 404
    },
    {
      "src": "/api/([^/.]+)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/criterio/(.+)",
      "status": 301,
      "headers": { "Location": "/blog/$1" }
    },
    {
      "src": "/criterio/?",
      "status": 301,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "/blog",
      "status": 308,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "/blog/",
      "dest": "/blog/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
